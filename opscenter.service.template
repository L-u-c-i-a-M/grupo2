[Unit]
Description=OpsCenter FastAPI - ITS Lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/htdocs/REPLACE_DOMAIN
EnvironmentFile=%h/htdocs/REPLACE_DOMAIN/.env
ExecStart=%h/htdocs/REPLACE_DOMAIN/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port REPLACE_PORT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
